@model FileContentResult
@{
    ViewData["Title"] = "QRCode";
}

<h1>QRCode đã tạo</h1>

<div class="row">
    <div class="col-md-12">
        <img src="data:image/png;base64,@Convert.ToBase64String(Model.FileContents)" alt="QR Code" />
        <img src="@Model.FileContents" alt="QR Code" />
    </div>
</div>


@model PollBuilder.MVC.Contracts.Responses.PollResponseDto
@{
    ViewData["Title"] = "Vote: " + Model.Title;
}

<h2>@Model.Title</h2>

<form id="voteForm">
    @foreach (var q in Model.Questions.OrderBy(x => x.Position))
    {
        <div class="mb-4">
            <h5>@q.QuestionText</h5>
            @foreach (var o in q.Options.OrderBy(x => x.Position))
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="question-@q.Id" value="@o.Id" id="opt-@o.Id" />
                    <label class="form-check-label" for="opt-@o.Id">@o.OptionText</label>
                </div>
            }
        </div>
    }

    <div id="voteError" class="text-danger mb-3"></div>
    <button type="button" id="btnSubmitVote" class="btn btn-primary">Vote</button>
</form>

@section Scripts {
<script>
    document.getElementById("btnSubmitVote").addEventListener("click", function () {
        const errorBox = document.getElementById("voteError");
        errorBox.textContent = "";

        const checked = document.querySelectorAll('#voteForm input[type=radio]:checked');
        if (checked.length === 0) {
            errorBox.textContent = "Vui lòng chọn ít nhất 1 lựa chọn.";
            return;
        }

        const selectedOptionIds = Array.from(checked).map(r => r.value);

        fetch(window.location.pathname, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(selectedOptionIds)
        })
        .then(async function (res) {
            if (!res.ok) throw new Error((await res.text()) || "Vote thất bại.");
            window.location.href = "/poll/@Model.Url/result";
        })
        .catch(function (err) {
            errorBox.textContent = err.message;
        });
    });
</script>
}
using MediatR;
using Microsoft.EntityFrameworkCore;
using PollBuilder.Application.DTOs;
using PollBuilder.Application.Exceptions;
using PollBuilder.Application.Interfaces;
using PollBuilder.Domain.Entities;


namespace PollBuilder.Application.Features.Polls.Queries.GetPollByLink
{
	public class GetPollByLinkHandler : IRequestHandler<GetPollByLinkQuery, PollDto>
	{
		private readonly IPollBuilderDbContext _context;

		public GetPollByLinkHandler(IPollBuilderDbContext context)
		{
			_context = context;
		}

		public async Task<PollDto> Handle(GetPollByLinkQuery request, CancellationToken cancellationToken)
		{
			var poll = await _context.Polls
				.Include(p => p.Questions)
					.ThenInclude(q => q.Options)
				.FirstOrDefaultAsync(p => p.Url == request.Link, cancellationToken)
				?? throw new NotFoundException(nameof(Poll), request.Link);

			var pollDto = new PollDto
			{
				Id = poll.Id,
				Title = poll.Title,
				Url = poll.Url,
				Status = poll.Status.ToString(),
				Questions = poll.Questions.Select(q => new Question
				{
					Id = q.Id,
					Text = q.Text,
					Options = q.Options.Select(o => new OptionDto
					{
						Id = o.Id,
						OptionText = o.OptionText
					}).ToList()
				}).ToList(),
				CreatedAt = poll.CreatedAt,
				ClosedAt = (DateTime)poll.ClosedAt,
				UserId = poll.UserId,
				User = poll.User
			};
			
		}
	
	}
}